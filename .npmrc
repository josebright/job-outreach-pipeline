# Skip Puppeteer's Chromium download during npm install.
# Puppeteer is a v2 legacy dependency (used for the deprecated auto-apply
# PDF generation). The v3 outreach pipeline never invokes it, so downloading
# 150MB of Chromium on every Railway build is pure waste.
puppeteer_skip_download=true

# Support both the old and new env-var names for the same setting.
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
