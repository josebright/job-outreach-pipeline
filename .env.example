# .env.example
# Copy to .env and fill in each active key.
# Everything active below is what the current build actually uses.
# Anything commented out is deliberately deferred.


# ── DISCOVERY (Module 1) ─────────────────────────────────────
# SERP for slug discovery via Google dorks.
# Sign up: https://serper.dev  (Google login, copy API key from dashboard)
# Free tier: 2,500 queries. Paid: $5 for 50k. Recommended.
SERPER_API_KEY=


# ── ENRICHMENT (Module 4) ────────────────────────────────────
# Hunter for contact search + verification.
# Sign up: https://hunter.io/users/sign_up  ->  API tab in the dashboard.
# Free plan: 50 credits/month (enough for Week 4 dev + first 15-25 companies).
# Upgrade to Starter ($34/mo, 500 searches + 1,000 verifications) when the
# funnel produces more qualified companies than the free tier can enrich.
HUNTER_API_KEY=


# ── LLM (Modules 5 and 3/6) ──────────────────────────────────
# Claude Sonnet for drafts + hook verification (Module 5).
# Get one: https://console.anthropic.com  ->  Settings  ->  API Keys
# Cost: pay-as-you-go, ~$10-20 total for the whole 90-day campaign.
ANTHROPIC_API_KEY=

# Gemini Flash for cheap classification (Module 3 auxiliary + Module 6 reply sentiment).
# Get one: https://aistudio.google.com/apikey  ->  Create API Key
# Free tier: 1,500 requests/day. No paid upgrade planned.
GEMINI_API_KEY=


# ── SENDING + REPLY POLLING (Module 6) ───────────────────────
# Gmail API OAuth2 credentials. Full setup in the earlier walkthrough:
#   1. https://console.cloud.google.com  ->  new project "job-outreach"
#   2. Enable "Gmail API" under APIs & Services -> Library
#   3. Google Auth Platform -> Branding wizard, add test user
#   4. Clients -> Create Client (Web application), redirect URI
#      https://developers.google.com/oauthplayground
#   5. Get refresh token from https://developers.google.com/oauthplayground
#      using your own OAuth credentials (gear icon), scopes:
#         https://www.googleapis.com/auth/gmail.send
#         https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# ── REVIEW UI (Module 6) ─────────────────────────────────────
# Airtable base for pending_review drafts.
# API key: https://airtable.com/create/tokens  (personal access token,
#          scopes: data.records:read + data.records:write + schema.bases:read,
#          grant it access to your outreach base)
# Base ID: the "app..." segment in the URL when the base is open in the browser.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=


# ─────────────────────────────────────────────────────────────
# DELIBERATELY DEFERRED. Do not fill in unless we agree to switch strategy.
# ─────────────────────────────────────────────────────────────

# APOLLO_API_KEY=
#   Second enrichment provider. Costs $49/mo (Apollo Basic).
#   Add only if Hunter coverage falls below 45% on qualified companies in Week 4.

# PROXYCURL_API_KEY=
#   Company data (HQ country, headcount). Paid per call.
#   Add only if the Nigeria-presence scoring signal needs a programmatic source.

# SERPAPI_KEY=
#   Alternative to Serper.dev. Not needed.

# PIPELINE_DB_PATH=
#   Override the SQLite path. Default: ./data/pipeline.db

# LOG_LEVEL=
#   trace | debug | info | warn | error. Default: info.
